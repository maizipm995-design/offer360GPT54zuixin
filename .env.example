# Offer360 服务器生产环境 .env 模板
# 使用方式：
# 1. 复制为 /opt/offer360/.env
# 2. 把所有 CHANGE_ME_* 替换为真实值
# 3. 保持该文件只存在服务器，不要提交 Git

# stack / image
STACK_NAME=offer360-prod
APP_IMAGE_TAG=latest

# host ports
# 这里是服务器生产环境宿主机端口，不是本地开发预览端口 13000 / 14000
WEB_PORT_HOST=3000
API_PORT_HOST=4000
MYSQL_PORT_HOST=3306
REDIS_PORT_HOST=6379
ELASTICSEARCH_PORT_HOST=9200

# runtime
NODE_ENV=production
JWT_SECRET=CHANGE_ME_JWT_SECRET
AUTH_CODE_SECRET=CHANGE_ME_AUTH_CODE_SECRET

# mysql / redis / es
MYSQL_DATABASE=offer360
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD

# api
API_PORT=4000
SERVER_NAME=www.offer360.cn
CORS_ORIGIN=https://www.offer360.cn,https://offer360.cn
WEB_APP_BASE_URL=https://www.offer360.cn
INTERVIEW_TRANSCRIPT_WORKFLOW_RUN_URL=https://5f7454nvm6.coze.site/stream_run
INTERVIEW_TRANSCRIPT_WORKFLOW_TOKEN=CHANGE_ME_INTERVIEW_TRANSCRIPT_WORKFLOW_TOKEN
AUTH_CODE_TTL_MINUTES=5
AUTH_CODE_LENGTH=6
CLIENT_MAX_BODY_SIZE=50m

# aliyun sms
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_ACCESS_KEY_ID=CHANGE_ME_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=CHANGE_ME_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=CHANGE_ME_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=CHANGE_ME_SMS_TEMPLATE_CODE
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code

# aliyun oss
OSS_REGION=CHANGE_ME_OSS_REGION
OSS_ENDPOINT=CHANGE_ME_OSS_ENDPOINT
OSS_BUCKET=CHANGE_ME_OSS_BUCKET
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_KEY_SECRET
OSS_STS_ROLE_ARN=CHANGE_ME_OSS_STS_ROLE_ARN
OSS_STS_ENDPOINT=sts.aliyuncs.com
OSS_UPLOAD_EXPIRE_SECONDS=900
OSS_SIGN_EXPIRE_SECONDS=1800
OSS_CUSTOM_DOMAIN=https://static.offer360.cn

# web
NEXT_PUBLIC_API_BASE_URL=https://www.offer360.cn/api
INTERNAL_API_BASE_URL=http://api:4000/api
NEXT_SERVER_ACTIONS_ALLOWED_ORIGINS=www.offer360.cn,offer360.cn

# wechat pay
WECHAT_PAY_ORDER_EXPIRE_MINUTES=15
WECHAT_PAY_APP_ID=CHANGE_ME_WECHAT_APP_ID
WECHAT_PAY_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
WECHAT_PAY_NOTIFY_URL=https://www.offer360.cn/api/proxy/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://www.offer360.cn/api/proxy/payments/wechat/refund/notify
WECHAT_PAY_CALLBACK_BASE_URL=https://www.offer360.cn

# wechat pay gateway cert settings
# Host machine cert directory. The container always reads from /app/.config/certs.
WECHAT_PAY_CERTS_HOST_PATH=/opt/offer360/certs
WECHAT_PAY_MCH_ID=CHANGE_ME_WECHAT_MCH_ID
WECHAT_PAY_MCH_CERT_SERIAL_NO=CHANGE_ME_MCH_CERT_SERIAL
WECHAT_PAY_PUBLIC_KEY_ID=CHANGE_ME_WECHAT_PUBLIC_KEY_ID
WECHAT_PAY_API_V3_KEY=CHANGE_ME_WECHAT_API_V3_KEY
