# Single source of truth: all runtime config must be placed in this root .env file.

# stack / ports
STACK_NAME=gpt54-o360-dev
GATEWAY_HTTP_PORT=18080
DEV_WEB_PORT=13000
DEV_API_PORT=14000
DEV_MYSQL_PORT=13306
DEV_REDIS_PORT=16379
DEV_ELASTICSEARCH_PORT=19200
DEV_WECHAT_PAY_GATEWAY_PORT=15000
DEV_PHPMYADMIN_PORT=13307
WEBHOOK_PORT=19090

# shared
NODE_ENV=development
JWT_SECRET=CHANGE_ME_JWT_SECRET
AUTH_CODE_SECRET=CHANGE_ME_AUTH_CODE_SECRET

# mysql / redis / es
MYSQL_DATABASE=offer360
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=mysql://root:CHANGE_ME_DB_PASSWORD@127.0.0.1:13306/offer360
REDIS_URL=redis://127.0.0.1:16379
ELASTICSEARCH_NODE=http://127.0.0.1:19200

# api
API_PORT=4000
CORS_ORIGIN=http://localhost:13000,https://offer360.cn
WEB_APP_BASE_URL=https://offer360.cn
AUTH_CODE_TTL_MINUTES=5
AUTH_CODE_LENGTH=6
PUPPETEER_EXECUTABLE_PATH=

# aliyun sms
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_ACCESS_KEY_ID=CHANGE_ME_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=CHANGE_ME_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=CHANGE_ME_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=CHANGE_ME_SMS_TEMPLATE_CODE
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code

# aliyun oss
OSS_REGION=CHANGE_ME_OSS_REGION
OSS_ENDPOINT=CHANGE_ME_OSS_ENDPOINT
OSS_BUCKET=CHANGE_ME_OSS_BUCKET
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_KEY_SECRET
OSS_STS_ROLE_ARN=CHANGE_ME_OSS_STS_ROLE_ARN
OSS_STS_ENDPOINT=sts.cn-beijing.aliyuncs.com
OSS_UPLOAD_EXPIRE_SECONDS=900
OSS_SIGN_EXPIRE_SECONDS=1800
OSS_CUSTOM_DOMAIN=CHANGE_ME_OSS_CUSTOM_DOMAIN

# web
NEXT_PUBLIC_API_BASE_URL=https://offer360.cn/api
INTERNAL_API_BASE_URL=http://api:4000/api
NEXT_SERVER_ACTIONS_ALLOWED_ORIGINS=offer360.cn,www.offer360.cn,localhost:13000,127.0.0.1:13000

# wechat pay
WECHAT_PAY_GATEWAY_URL=http://localhost:15000
WECHAT_PAY_ORDER_EXPIRE_MINUTES=15
WECHAT_PAY_APP_ID=CHANGE_ME_WECHAT_APP_ID
WECHAT_PAY_APP_SECRET=CHANGE_ME_WECHAT_APP_SECRET
WECHAT_PAY_NOTIFY_URL=https://offer360.cn/api/proxy/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://offer360.cn/api/proxy/payments/wechat/refund/notify
WECHAT_PAY_CALLBACK_BASE_URL=https://offer360.cn

# wechat pay gateway cert settings
WECHAT_PAY_GATEWAY_PORT=15000
WECHAT_PAY_GATEWAY_HOST_PORT=15000
WECHAT_PAY_MCH_ID=CHANGE_ME_WECHAT_MCH_ID
WECHAT_PAY_MCH_CERT_SERIAL_NO=CHANGE_ME_MCH_CERT_SERIAL
WECHAT_PAY_PUBLIC_KEY_ID=CHANGE_ME_WECHAT_PUBLIC_KEY_ID
WECHAT_PAY_API_V3_KEY=CHANGE_ME_WECHAT_API_V3_KEY
WECHAT_PAY_PRIVATE_KEY_PATH=.config/certs/apiclient_key.pem
WECHAT_PAY_MCH_CERT_PATH=.config/certs/apiclient_cert.pem
WECHAT_PAY_PUBLIC_KEY_PATH=.config/certs/wechat_pay_public_key.pem
